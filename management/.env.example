# Management Terminal — local-dev env template.
# Copy to management/.env.local and fill in. .env.local is gitignored.
#
# Production values are set in the Vercel project (Settings -> Environment
# Variables), NOT committed here.
#
# Management lives on its OWN Supabase project (separate from macro/correlation).
# The VITE_MANAGEMENT_* names are preferred; the legacy VITE_SUPABASE_* names
# still work as a fallback for single-project setups.

VITE_MANAGEMENT_SUPABASE_URL=https://<your-management-project-ref>.supabase.co
VITE_MANAGEMENT_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxx
