# Exclude everything that's not needed at runtime on the static deploy.
# The Vercel build serves:
#   launcher/, macro/dashboard/, macro/catalog/, vercel.json

# Server-side ETL & maintenance (Python — Vercel doesn't run them).
# scripts/vercel-build.sh is needed by the buildCommand, so we exclude
# items individually instead of the whole scripts/ folder -- once a
# parent directory is excluded, gitignore-style negation can't re-add
# anything inside it.
macro/scripts/
correlation/scripts/
scripts/*.py
scripts/apply-mgmt-sql.js
scripts/serve.js

# Correlation Flask backend only — the static frontend (correlation/ui/static/)
# now talks to Supabase directly and IS deployed.
correlation/ui/backend/
correlation/ui/README.md

# Supabase migrations (one-time, applied via SQL Editor)
supabase/

# Catalog staging files only used by the correlation pipeline
correlation/catalog/staging/

# Documentation / READMEs that aren't served (anchored: only the repo-root one,
# leave management/README.md alone).
/README.md
# Agent / dev docs — not runtime assets. Keep LEGION's operating manual and the
# CLAUDE.md pointer out of the public deploy (no secrets, but no reason to serve).
/LEGION.md
/CLAUDE.md
correlation/catalog/universe.json.bak
correlation/catalog/universe.json.bak2

# Quickstart helpers (Windows)
Quickstart.bat
Stop.bat

# Repo-root dev-tooling manifest only. management/package.json and
# yggdrasil/package.json MUST reach the build server -- without the leading
# slash this glob was matching them too, causing the build to fail.
/package.json

# Brain backups (L3) — JSON dumps of brain.notes + audit + vault metadata,
# written by scripts/backup_brain.py and the nightly GitHub Action. Forensic
# storage only; not a runtime asset.
backups/
