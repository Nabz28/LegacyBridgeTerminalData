# Exclude everything that's not needed at runtime on the static deploy.
# The Vercel build serves:
#   launcher/, macro/dashboard/, macro/catalog/, vercel.json

# Server-side ETL & maintenance (Python — Vercel doesn't run them)
macro/scripts/
correlation/scripts/
scripts/

# Correlation Flask backend only — the static frontend (correlation/ui/static/)
# now talks to Supabase directly and IS deployed.
correlation/ui/backend/
correlation/ui/README.md

# Supabase migrations (one-time, applied via SQL Editor)
supabase/

# Catalog staging files only used by the correlation pipeline
correlation/catalog/staging/

# Documentation / READMEs that aren't served
README.md
correlation/catalog/universe.json.bak
correlation/catalog/universe.json.bak2

# Quickstart helpers (Windows)
Quickstart.bat
Stop.bat
package.json
