# Copy this file to `.env` and fill in for your environment.
# `.env` is gitignored so secrets never get committed.

# --------------------------------------------------------------------------- #
# Local data store                                                            #
# --------------------------------------------------------------------------- #
# Path (absolute or relative to repo root) where the SQLite databases and
# correlation parquet files live. The dev server (scripts/serve.js) mounts
# this under `/data/` for the dashboard. Layout expected inside:
#
#   <DATA_STORE_PATH>/
#     macro/
#       us.sqlite  id.sqlite  cn.sqlite
#       curation_batches/...
#     correlation/
#       correlation.sqlite
#       matrices/*.parquet
#       returns/*.parquet
#       raw/...
#
# serve.js mounts <DATA_STORE_PATH>/macro under /data/ for the dashboard.
# upload_to_supabase.py reads both macro/ and correlation/ subfolders.
DATA_STORE_PATH=../data-store

# --------------------------------------------------------------------------- #
# Supabase (required only if you intend to upload data or switch the          #
# dashboard to dataSource = 'supabase')                                       #
# --------------------------------------------------------------------------- #
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-public-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-server-side-service-role-key
