{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": true,
  "buildCommand": "cd management && npm install && npm run build && rm -f index.html && cd ../yggdrasil && npm install && npm run build && rm -f index.html",
  "outputDirectory": ".",
  "redirects": [
    { "source": "/", "destination": "/launcher/", "permanent": false },
    { "source": "/macro", "destination": "/macro/dashboard/", "permanent": false },
    { "source": "/macro/", "destination": "/macro/dashboard/", "permanent": false },
    { "source": "/correlation", "destination": "/correlation/ui/static/", "permanent": false },
    { "source": "/correlation/", "destination": "/correlation/ui/static/", "permanent": false }
  ],
  "rewrites": [
    { "source": "/management", "destination": "/management/dist/index.html" },
    { "source": "/management/", "destination": "/management/dist/index.html" },
    { "source": "/management/:path*", "destination": "/management/dist/:path*" },
    { "source": "/yggdrasil", "destination": "/yggdrasil/dist/index.html" },
    { "source": "/yggdrasil/", "destination": "/yggdrasil/dist/index.html" },
    { "source": "/yggdrasil/:path*", "destination": "/yggdrasil/dist/:path*" }
  ],
  "headers": [
    {
      "source": "/macro/catalog/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=3600, s-maxage=3600" }
      ]
    },
    {
      "source": "/management/dist/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/yggdrasil/dist/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/(.*)\\.js",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=300, s-maxage=300" }
      ]
    }
  ]
}
