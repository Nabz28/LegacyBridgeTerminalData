# ─── Build / dependency artifacts ──────────────────────────────────
node_modules
dist
*.pyc
__pycache__
.venv
venv
.pytest_cache
.ruff_cache

# ─── Local environment / secrets ───────────────────────────────────
.env
.env.local
.env.*.local
macro/dashboard/js/config.js

# ─── OS junk ───────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ─── Claude Code internal state ────────────────────────────────────
.claude/

# ─── Data store (external, never committed) ────────────────────────
# Time-series databases and large correlation parquet files live in
# `data-store/` outside the repo. See README "Data store".
data/
data-store/
correlation/data/

# Legacy SQLite at correlation root (pre-restructure)
correlation/*.sqlite
correlation/*.db

# SQLite working files
**/*.sqlite-journal
**/*.sqlite-wal
**/*.sqlite-shm

# ─── Logs ──────────────────────────────────────────────────────────
*/logs/
*.log

# ─── Catalog JSONs (curated content) ARE committed on purpose ──────
# macro/catalog/* and correlation/catalog/* are part of the infrastructure
# and ship in this repo so the apps work after `git clone` + a populated
# `data-store/` (or a Supabase project configured in dashboard config.js).
