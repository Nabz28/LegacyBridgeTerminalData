# ─── Build / dependency artifacts ──────────────────────────────────
node_modules
dist
*.pyc
__pycache__
.venv
venv
.pytest_cache
.ruff_cache

# ─── Local environment / secrets ───────────────────────────────────
.env
.env.local
.env.*.local
macro/dashboard/js/config.js
network/dashboard/js/config.js

# ─── OS junk ───────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ─── Claude Code internal state ────────────────────────────────────
.claude/

# ─── Data store (external, never committed) ────────────────────────
# Time-series databases and large correlation parquet files live in
# `data-store/` outside the repo. See README "Data store".
/data/
data-store/
correlation/data/
# Note: correlation/ui/static/data/ is the precomputed template matrices +
# series_meta + cluster_order — IS committed (needed by the Vercel deploy).
# The /data/ pattern above is anchored to repo root only so it doesn't
# match nested data/ subdirs.

# macro/dashboard relies on the in-repo catalog at macro/catalog/ — leave alone
# Don't add a blanket **/data/ rule.

# Legacy SQLite at correlation root (pre-restructure)
correlation/*.sqlite
correlation/*.db

# SQLite working files
**/*.sqlite-journal
**/*.sqlite-wal
**/*.sqlite-shm

# ─── Logs ──────────────────────────────────────────────────────────
*/logs/
*.log

# ─── Catalog JSONs (curated content) ARE committed on purpose ──────
# macro/catalog/* and correlation/catalog/* are part of the infrastructure
# and ship in this repo so the apps work after `git clone` + a populated
# `data-store/` (or a Supabase project configured in dashboard config.js).
management/dist/
management/node_modules/
yggdrasil/dist/
yggdrasil/node_modules/
yggdrasil/tsconfig.tsbuildinfo
.vercel

# ─── Brain backups (L3) ────────────────────────────────────────────
# Local dumps of the brain. The nightly workflow pushes these to the
# PRIVATE Nabz28/LBC-brain-backups repo — they MUST NEVER land in this
# public launcher repo. Local-only scratch dir.
backups/
.cal/

.legion_*.json

.wacc_dataset*.json
.bt/
bt_*.json
.env*.local

# local runner log
scripts/research/local-ingest.log
