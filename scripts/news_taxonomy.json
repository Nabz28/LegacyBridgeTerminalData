  "tiers": {
    "T1": {
      "weight": 1.0,
      "label": "Systemic barometer (defines country risk)"
    },
    "T2": {
      "weight": 0.55,
      "label": "Key sub-market / macro aggregate"
    },
    "T3": {
      "weight": 0.3,
      "label": "Sector / single-name"
    },
    "GL": {
      "weight": 0.5,
      "label": "Global spillover into Indonesia risk"
    }
  },
  "level_scale": {
    "doc": "Magnitude of the expected 1-5 day move, VOL-NORMALIZED to the target's own daily sigma. The agent estimates the move and maps it via each target's `sigma` anchor. Sign = the target's NATURAL direction (up=+); risk transmission is applied separately via `risk_sign`.",
    "5": ">3 sigma  (tail / extreme, regime-shifting)",
    "4": "2-3 sigma (very large, dominant driver of the day)",
    "3": "1.25-2 sigma (large, clear first-order move)",
    "2": "0.5-1.25 sigma (moderate, noticeable)",
    "1": "<0.5 sigma (minor / second-order)",
    "0": "negligible or already fully priced"
  },
  "surprise": {
    "doc": "What actually moves markets is the surprise vs what is priced. Multiplies the aggregate magnitude. Four buckets so the agent isn't forced into a binary on ambiguous cases.",
    "priced": 0.1,
    "partial": 0.45,
    "likely": 0.7,
    "surprise": 1.0,
    "telegraphed": 0.05
  },
  "rollup": {
    "doc": "raw = surprise * sum(weight*risk_sign*level/5) / SQRT(sum(weight)); the sqrt denominator (not a plain average) REWARDS breadth — a 5-asset crisis outscores a 1-asset move — while still penalising a pile of marginal noise targets. GL (global) contributions are halved when their net sign matches T1 (correlation haircut: USD already explains the IDR move). score = 100*tanh(GAIN*raw). importance from top-3 weighted severity, not the single peak.",
    "gain": 1.0,
    "flat_threshold": 20,
    "gl_correlation_haircut": 0.5,
    "importance_thresholds": {
      "high": 3.0,
      "med": 1.5
    },
    "level_sigma": {
      "1": 0.35,
      "2": 0.85,
      "3": 1.6,
      "4": 2.5,
      "5": 3.5
    },
    "type_transmission": {
      "monetary": 1.0,
      "inflation": 1.0,
      "growth": 0.85,
      "fiscal": 0.7,
      "politics": 0.35,
      "industrial_policy": 0.7,
      "subsidy_energy": 0.8,
      "trade": 0.85,
      "commodities": 1.0,
      "markets": 1.0,
      "fx": 1.0,
      "banking": 0.9,
      "corporate": 0.9,
      "geopolitics": 0.4,
      "other": 0.8
    },
    "_backtest_note": "Validated 2026-06 vs forward prices (n=40): directional edge ~60-67% best at +1d; score is a CONVICTION signal not a return forecast; rupiah is context-only (below noise floor). type_transmission damps headline types that historically do not move IDX equity."
  },
